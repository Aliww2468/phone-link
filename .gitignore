# ============================================================
#  PhoneLink
# ============================================================

# ---- 构建工具链：约 1 GB（JDK + Android SDK），不入库 ----
# 需要时运行 toolchain/setup-toolchain.ps1 自动装回来
toolchain/*
!toolchain/setup-toolchain.ps1

# ---- 构建中间产物 ----
build/

# ---- 打包缓存（Node 运行时 zip 等），build-pc-package.ps1 会自动下载 ----
.cache/

# ---- 组装出来的安装包目录（zip 本身保留在 dist/ 下）----
dist/PhoneLink-PC/

# ---- 分发用的大压缩包只挂到 GitHub Release，不进 git 历史 ----
dist/*.zip

# ---- 签名密钥：口令是固定的，公开等于任何人都能签出
#      能覆盖安装到你手机上的 APK，绝不入库 ----
phonelink.jks
*.jks
*.keystore

# ---- 运行时数据：消息记录 + 配对令牌，属于隐私 ----
pc/data/
pc/config.json

# ---- 签名副产物（v4 签名文件，安装用不到）----
dist/*.idsig

# ---- 系统 / 编辑器 ----
Thumbs.db
Desktop.ini
desktop.ini
.DS_Store
.vscode/
.idea/
*.swp
*~
